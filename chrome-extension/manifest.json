{
  "manifest_version": 3,
  "name": "Read It Later",
  "version": "1.0.0",
  "description": "一键保存链接到 Mac 刘海 Read It Later 应用",
  "permissions": [
    "activeTab",
    "tabs",
    "notifications",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
